# Database (SQLite dev by default; swap for PostgreSQL in prod)
DATABASE_URL=sqlite:///./val_analytics.db

# Riot API
RIOT_API_KEY=RGAPI-xxxx
RSO_CLIENT_ID=your_client_id
RSO_CLIENT_SECRET=your_client_secret
RSO_REDIRECT_URI=http://localhost:8000/api/auth/riot/callback

# Gemini AI (structured-output prompts require a key; harness falls back to UpstreamError otherwise)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# Supabase — backend verifies the Supabase JWT to resolve the caller's team.
# SUPABASE_JWT_SECRET = "JWT Secret" in Supabase > Project Settings > API.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated

# Local dev escape hatch: bypass auth and fall back to the first user/team in DB.
# DO NOT enable in production.
DEV_AUTH_BYPASS=0

# Misc
FERNET_KEY=your_fernet_key
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
